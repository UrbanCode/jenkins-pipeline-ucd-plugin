<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <j:set var="helpURL" value="/plugin/ibm-ucdeploy-build-steps"/>

  <f:entry title="DevOps Deploy Server" help="${helpURL}/site.html">
    <select class="setting-input" name="siteName">
      <j:forEach var="s" items="${descriptor.getSites()}">
        <f:option selected="${s.displayName==instance.siteName}">${s.displayName}</f:option>
      </j:forEach>
    </select>
  </f:entry>

  <f:entry title="Alternative Username (optional)" help="${helpURL}/altUser/alt-username.html">
    <f:textbox field="altUsername"/>
  </f:entry>
  <f:entry title="Alternative Password (optional)" help="${helpURL}/altUser/alt-password.html">
    <f:password field="altPassword"/>
  </f:entry>

  <f:entry field="applicationName" title="Application Name" help="${helpURL}/deploy/app.html">
    <f:textbox/>
  </f:entry>
  <f:entry field="processName" title="Application Process Name" help="${helpURL}/deploy/appproc.html">
    <f:textbox/>
  </f:entry>
  <f:entry field="componentProcessName" title="Component Process Name" help="${helpURL}/deploy/create/comp.html">
    <f:textbox/>
  </f:entry>
</j:jelly>
